<Window x:Class="WedApiRyd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WedApiRyd"
        mc:Ignorable="d"
        Title="Подписки" Height="600" Width="1500">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Активна:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ComboBoxActive" SelectedValue="{Binding filtActive, Mode=TwoWay}" SelectedValuePath="Tag" Width="80" Margin="0,0,15,0">
                    <ComboBoxItem Content="Все" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="Да" Tag="True"/>
                    <ComboBoxItem Content="Нет" Tag="False"/>
                </ComboBox>

                <TextBlock Text="Макс. цена:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TextBoxPrice" Text="{Binding filtMaxPrice, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,10,0"/>

                <Button Content="Фильтр" Click="Filter2" Margin="10,0,0,0" Padding="10,2"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="GridMovies" ItemsSource="{Binding Subscriptions}"
                    SelectedItem="{Binding CurrentSubscription, Mode=TwoWay}"
                    SelectionChanged="Change"
                    AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                    <DataGridTextColumn Header="Дней" Binding="{Binding DurationDays}" Width="60"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                    <DataGridCheckBoxColumn Header="Активна" Binding="{Binding IsActive}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel x:Name="Current" Orientation="Vertical">
                <TextBlock Text="Редактирование" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="ID:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding Id, Mode=TwoWay}" IsEnabled="False" Margin="0,0,0,5"/>

                <TextBlock Text="Название:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                <TextBlock Text="Цена:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                <TextBlock Text="Дней:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding DurationDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                <TextBlock Text="Описание:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" Margin="0,0,0,5"/>

                <CheckBox Content="Активна" IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>


                <Button Content="PATCH" Click="PatchChanges" Margin="0,5" />
                <Button Content="PUT" Click="SaveChanges" Margin="0,5"/> 
                

                <Button Content="POST" Click="Create" Margin="0,5"/>
                <Button Content="DELETE" Click="Delete" Margin="0,5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>